{
  "name": "al-qadir-traders-sale-working",
  "version": "1.0.0",
  "private": true,
  "description": "Al Qadir Traders Sale Working - Android, Windows and web package",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop:build": "electron-builder --win nsis",
    "android:init": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.alqadirtraders.saleworking",
    "productName": "Al Qadir Traders Sale Working",
    "files": ["www/**/*", "electron/**/*", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis", "portable"]},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
