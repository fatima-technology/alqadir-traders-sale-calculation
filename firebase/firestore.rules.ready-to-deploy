rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{userId}/agency/{backupId} {
      allow read: if signedIn() && request.auth.uid == userId && backupId == 'main';
      allow create, update: if signedIn() && request.auth.uid == userId
        && backupId == 'main' && request.resource.data.ownerUid == userId;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
